  "components": {
    "schemas": {
      "ActiveBody": {
        "properties": {
          "active": {
            "type": "boolean",
            "title": "Active"
          }
        },
        "type": "object",
        "required": [
          "active"
        ],
        "title": "ActiveBody"
      },
      "AnswersBody": {
        "properties": {
          "answers": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "maxProperties": 3,
            "title": "Answers"
          }
        },
        "type": "object",
        "required": [
          "answers"
        ],
        "title": "AnswersBody"
      },
      "ApplicationBody": {
        "properties": {
          "resume": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 40,
            "title": "Resume"
          },
          "consent": {
            "type": "boolean",
            "const": true,
            "title": "Consent"
          },
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 2,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "resume",
          "consent",
          "name"
        ],
        "title": "ApplicationBody"
      },
      "Body_pdf_extract_api_resume_extract_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_pdf_extract_api_resume_extract_post"
      },
      "EmployerBody": {
        "properties": {
          "company": {
            "type": "string",
            "maxLength": 160,
            "minLength": 2,
            "title": "Company"
          },
          "code": {
            "type": "string",
            "maxLength": 200,
            "title": "Code",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "company"
        ],
        "title": "EmployerBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InviteBody": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 1500,
            "minLength": 10,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "InviteBody"
      },
      "JobBody": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 3,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 30,
            "title": "Description"
          },
          "terms": {
            "type": "string",
            "maxLength": 500,
            "title": "Terms",
            "default": ""
          },
          "requirements": {
            "items": {
              "$ref": "#/components/schemas/Requirement"
            },
            "type": "array",
            "maxItems": 15,
            "minItems": 1,
            "title": "Requirements"
          }
        },
        "type": "object",
        "required": [
          "title",
          "description",
          "requirements"
        ],
        "title": "JobBody"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login"
      },
      "MaxBody": {
        "properties": {
          "init_data": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Init Data"
          }
        },
        "type": "object",
        "required": [
          "init_data"
        ],
        "title": "MaxBody"
      },
      "Registration": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 2,
            "title": "Name"
          },
          "company": {
            "type": "string",
            "maxLength": 160,
            "title": "Company",
            "default": ""
          },
          "role": {
            "type": "string",
            "enum": [
              "employer",
              "candidate"
            ],
            "title": "Role",
            "default": "candidate"
          },
          "code": {
            "type": "string",
            "maxLength": 200,
            "title": "Code",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "email",
          "password",
          "name"
        ],
        "title": "Registration"
      },
      "Requirement": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,40}$",
            "title": "Id"
          },
          "skill": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Skill"
          },
          "label": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Label"
          },
          "type": {
            "type": "string",
            "enum": [
              "must",
              "nice"
            ],
            "title": "Type",
            "default": "must"
          },
          "source": {
            "type": "string",
            "maxLength": 700,
            "title": "Source",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "id",
          "skill",
          "label"
        ],
        "title": "Requirement"
      },
      "TextBody": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 20,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TextBody"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
