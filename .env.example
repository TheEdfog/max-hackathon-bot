APP_NAME=РезюмИТ
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

SECRET_KEY=change_me_to_a_long_random_secret
SESSION_COOKIE_NAME=cvservice_session
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cvservice_db
# Docker PostgreSQL runs on localhost:5433 by default:
# DATABASE_URL=postgresql+psycopg://postgres:MyNewStrongPassword123!@localhost:5433/cvservice_db
# POSTGRES_DB=cvservice_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=MyNewStrongPassword123!
# POSTGRES_PORT=5433
# REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0

OPENAI_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-reasoner
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=8192

STORAGE_ROOT=storage
MAX_UPLOAD_SIZE_MB=25

LATEX_ENGINE=xelatex

# Optional: values from .env override config/app_config.toml
