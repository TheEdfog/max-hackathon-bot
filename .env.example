# Copy to .env.hiring. Never commit the filled file.
MAX_BOT_TOKEN=
MAX_BOT_NAME=t781_hakaton_max_bot
MAX_API_URL=https://platform-api2.max.ru
HIRING_EMPLOYER_CODE=
HIRING_SECRET=
HIRING_DATABASE_URL=sqlite:///data/hiring.db
HIRING_ENV=development
HIRING_DEMO=false
PUBLIC_URL=http://localhost:8000
MAX_WEBHOOK_SECRET=
# Future production domain without scheme. DNS must point at the server.
PUBLIC_HOST=
HIRING_WORKER=true

# Optional runtime model; credentials never go in Git.
# Choose/configure a provider using docs/LLM.md. Default makes no LLM calls.
HIRING_LLM_PROVIDER=disabled
HIRING_LLM_MODEL=
HIRING_LLM_BASE_URL=
HIRING_LLM_ALLOWED_HOSTS=
CLOUDRU_API_KEY=
LLM_API_KEY=
HIRING_LLM_MAX_TOKENS=1000
HIRING_LLM_TIMEOUT_SECONDS=12
HIRING_LLM_OWNER_DAILY_LIMIT=3
HIRING_LLM_DAILY_LIMIT=10
HIRING_LLM_TOTAL_LIMIT=50
