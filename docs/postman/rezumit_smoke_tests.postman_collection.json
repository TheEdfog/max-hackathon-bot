    {
      "name": "08. Vacancies Page Shows Saved Vacancy",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('vacancies page returns 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.text();",
              "const vacancyTitle = pm.collectionVariables.get('vacancy_title');",
              "pm.test('vacancies page contains test vacancy', function () {",
              "  pm.expect(body).to.include(vacancyTitle);",
              "});",
              "",
              "function escapeRegex(value) {",
              "  return value.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');",
              "}",
              "",
              "const titlePattern = escapeRegex(vacancyTitle);",
              "let match = body.match(new RegExp(`<h3>\\\\s*${titlePattern}\\\\s*<\\\\/h3>[\\\\s\\\\S]*?action=\\\"/vacancies/(\\\\d+)/extract\\\"`));",
              "if (!match) {",
              "  const allMatches = Array.from(body.matchAll(/action=\\\"\\/vacancies\\/(\\d+)\\/extract\\\"/g));",
              "  match = allMatches.length ? allMatches[allMatches.length - 1] : null;",
              "}",
              "if (match) {",
              "  pm.collectionVariables.set('vacancy_id', match[1]);",
              "}",
              "",
              "pm.test('vacancy id extracted from HTML', function () {",
              "  pm.expect(pm.collectionVariables.get('vacancy_id')).to.be.ok;",
              "});"
            ]
          }
        }
