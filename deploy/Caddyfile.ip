# IP clients omit SNI; Docker's private listener address is not the certificate IP.
{
    default_sni {$PUBLIC_HOST}
}

# Public IP certificates require Let's Encrypt's short-lived profile.
https://{$PUBLIC_HOST} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    request_body {
        max_size 6MB
    }
    handle_path /review/* {
        reverse_proxy review-api:8000
    }
    handle {
        reverse_proxy api:8000
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
}
