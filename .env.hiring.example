MAX_BOT_TOKEN=
MAX_BOT_NAME=
MAX_API_URL=https://platform-api2.max.ru
HIRING_EMPLOYER_CODE=
HIRING_SECRET=
HIRING_DATABASE_URL=sqlite:///data/hiring.db
HIRING_ENV=development
HIRING_DEMO=false
# HTTPS webhook and API origin:
PUBLIC_URL=http://localhost:8000
MAX_WEBHOOK_SECRET=
PUBLIC_HOST=
HIRING_WORKER=true

# Runtime-only model. disabled, cloudru, deepseek, openai_compatible.
HIRING_LLM_PROVIDER=disabled
# Cloud.ru has defaults; other enabled providers require a model. See docs/LLM.md.
HIRING_LLM_MODEL=
HIRING_LLM_BASE_URL=
HIRING_LLM_ALLOWED_HOSTS=
# Cloud.ru key is never forwarded to a different provider.
CLOUDRU_API_KEY=
LLM_API_KEY=
HIRING_LLM_MAX_TOKENS=1000
HIRING_LLM_TIMEOUT_SECONDS=12
HIRING_LLM_OWNER_DAILY_LIMIT=3
HIRING_LLM_DAILY_LIMIT=10
HIRING_LLM_TOTAL_LIMIT=50
